  <!-- EN: release to the wild -->
  <ReleaseToWild.label>जानवर को मुक्त करना</ReleaseToWild.label>
  <!-- EN:
    <li>r_logentry->[farewell] [released]</li>
    <li>farewell->[INITIATOR_nameDef] gently pet [RECIPIENT_nameDef] one last time</li>
    <li>farewell->[INITIATOR_nameDef] said some warm words to [RECIPIENT_nameDef]</li>
    <li>farewell->[INITIATOR_nameDef] removed [RECIPIENT_nameDef]'s collar</li>
    <li>farewell->[INITIATOR_nameDef] reminisced about the good time [INITIATOR_pronoun] had with [RECIPIENT_nameDef]</li>
    <li>released->and released [RECIPIENT_objective] to the wild.</li>
    <li>released->and set [RECIPIENT_objective] free.</li>
    <li>released->and sent [RECIPIENT_objective] off.</li>
    <li>released->and let [RECIPIENT_objective] go.</li>
    <li>released->then turned away and let [RECIPIENT_objective] leave the colony.</li>
    <li>released->before letting [RECIPIENT_objective] go to live in freedom.</li>
  -->
  <ReleaseToWild.logRulesInitiator.rulesStrings>
    <li>r_logentry->[farewell] [released]</li>
    <li>farewell->[INITIATOR_nameDef] धीरे से सहलाता है [RECIPIENT_nameDef] अंतिम बार</li>
    <li>farewell->[INITIATOR_nameDef] ने [RECIPIENT_nameDef] को कुछ प्यार भरे शब्द कहे [RECIPIENT_nameDef]</li>
    <li>farewell->[INITIATOR_nameDef] ने [RECIPIENT_nameDef] से कॉलर हटा लिया। [RECIPIENT_nameDef]</li>
    <li>farewell->[INITIATOR_nameDef] के साथ बिताए अच्छे समय को याद किया [RECIPIENT_nameDef]</li>
    <li>released->और छोड़ा [RECIPIENT_objective] प्रकृति में</li>
    <li>released->और सेट [RECIPIENT_objective] मुक्त।</li>
    <li>released->और भेजा [RECIPIENT_objective] दूर।</li>
    <li>released->और जाने देता है[RECIPIENT_objective] जाना।</li>
    <li>released->फिर वह मुड़ गया और [RECIPIENT_objective] कॉलोनी से जाने दिया।</li>
    <li>released->उसे आज़ादी में जीने के लिए जाने देने से पहले।</li>
  </ReleaseToWild.logRulesInitiator.rulesStrings>
  
